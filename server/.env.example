AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY is optional — Agora manages the OpenAI key by default (keyless).
# OPENAI_API_KEY=sk-your-openai-key
# AGENT_GREETING=Hi! Ask me anything — you'll hear me think out loud while I work.
# TTS_VOICE=English_captivating_female1
# Initial web selection and default for API requests that omit fillerWordsMode.
# Choose static or generated; the user can override it before each conversation.
# Restart the backend and refresh the page after changing this value.
# Generated uses the SDK's default Engine-managed generator; no filler LLM
# URL, API key, or model is needed.
FILLER_WORDS_MODE=static
