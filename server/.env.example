AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY is optional — Agora manages the OpenAI key by default (keyless).
# OPENAI_API_KEY=sk-your-openai-key
# AGENT_GREETING=Hi! Ask me anything — you'll hear me think out loud while I work.
# TTS_VOICE=English_captivating_female1
# `static` uses built-in phrases. Set to `generated` to use the generator
# provisioned for the App ID.
FILLER_WORDS_MODE=static
# Optional BYO provider override. Set all three fields together; Engine calls
# this public OpenAI-compatible endpoint directly.
# FILLER_LLM_BASE_URL=https://your-openai-compatible-provider/v1/chat/completions
# FILLER_LLM_API_KEY=your_provider_api_key
# FILLER_LLM_MODEL=your_provider_model
